# TerraVision AI Configuration

# FastAPI Backend Port & Host
PORT=8000
HOST=127.0.0.1

# Optional Multimodal Vision Keys (TerraVision defaults to local EarthVisionCV engine if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Engine Execution Mode: "auto", "cv_engine", "multimodal", "demo"
TERRAVISION_ANALYSIS_MODE=auto

# Security & Limits
MAX_IMAGE_SIZE_MB=20
REQUEST_TIMEOUT_SECONDS=15
